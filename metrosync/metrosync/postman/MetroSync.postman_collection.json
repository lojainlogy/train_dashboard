{
  "info": {
    "name": "MetroSync API",
    "_postman_id": "b2f5f3f0-metrosync-0001-000000000000",
    "description": "Login, stations, and announcements endpoints for the MetroSync backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "stationId", "value": "" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Auth - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "if (data.token) { pm.collectionVariables.set('token', data.token); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@metrosync.local\",\n  \"password\": \"ChangeMe123!\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "Stations - List All",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "if (data.data && data.data.length) { pm.collectionVariables.set('stationId', data.data[0]._id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/stations"
      }
    },
    {
      "name": "Announcements - List for Station",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/announcements/station/{{stationId}}?page=1&limit=20"
      }
    },
    {
      "name": "Announcements - Create (Admin)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Northbound trains delayed 5 minutes\",\n  \"station\": \"{{stationId}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/announcements"
      }
    },
    {
      "name": "Announcements - Create (No Token, expect 401)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Should be rejected\",\n  \"station\": \"{{stationId}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/announcements"
      }
    }
  ]
}
